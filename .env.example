# ---- Auth (Auth.js + Google SSO, clever.com only) -----------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web).
# Authorized redirect URI (local):  http://localhost:3000/api/auth/callback/google
# Authorized redirect URI (prod):   https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only accounts on this Google Workspace domain may sign in.
ALLOWED_EMAIL_DOMAIN=clever.com
# Local-only escape hatch: set to 1 to show a "dev sign-in" box on /login so you
# can run the app before Google OAuth is configured. Ignored in production.
AUTH_DEV_BYPASS=0

# ---- Roles -------------------------------------------------------------
# Comma-separated, case-insensitive. These people can open /admin.
ADMIN_EMAILS=tom.leger@clever.com,kate.schaff@clever.com,alex.armstead@clever.com

# ---- Database ----------------------------------------------------------
# Leave unset locally to use the embedded Postgres (PGlite) stored in ./.data.
# On Vercel, add Neon from the Marketplace and this gets set automatically.
# DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# ---- Feedback agent (eve.dev) ------------------------------------------
# The agent needs a model credential. Either one works:
#   AI_GATEWAY_API_KEY  -> Vercel AI Gateway key from the Clever Vercel team
#   ANTHROPIC_API_KEY   -> direct Anthropic key
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
# Shared secret the agent uses to write feedback through the app's internal API.
# Generate with: openssl rand -hex 24
INTERNAL_API_SECRET=
# Where the agent reaches the app. Defaults to http://localhost:3000 in dev and
# the production URL on Vercel; only set this if your dev server uses another port.
# APP_INTERNAL_URL=http://localhost:3000
